{
  "name": "cladistree",
  "productName": "CladisTree",
  "version": "1.4.0",
  "description": "A powerful cladogram making tool",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "node tests/format.test.js && node tests/sheet-variants.test.js && node tests/romer.test.js && node tests/formats.test.js && node tests/chrono.test.js && node tests/undo.test.js && node tests/static-checks.js",
    "test:format": "node tests/format.test.js",
    "test:variants": "node tests/sheet-variants.test.js",
    "test:smoke": "node tests/smoke.js",
    "test:static": "node tests/static-checks.js",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "keywords": [],
  "author": "N.Ennasri",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "41.0.4",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.4",
    "typescript": "~4.5.4"
  },
  "dependencies": {
    "cytoscape": "^3.33.1",
    "cytoscape-dagre": "^2.5.0",
    "cytoscape-svg": "^0.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "fflate": "^0.8.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1"
  }
}
